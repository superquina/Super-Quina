# Never place real credentials in this file.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
APP_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="https://superquina.com"

# Configure a random secret and call /api/internal/round-scheduler every minute with Authorization: Bearer <ROUND_SCHEDULER_SECRET>.
# The scheduler maintains up to 48 upcoming rounds across the next 24 hours at 30-minute intervals and processes Pix, opening, closing, draw and prize-settlement events.
# ROUND_SCHEDULER_SECRET="replace-with-a-long-random-secret"

# Mercado Pago Pix Orders API. Never commit real values to this file.
# MERCADOPAGO_ACCESS_TOKEN=""
# MERCADOPAGO_WEBHOOK_SECRET=""
# MERCADOPAGO_PAYER_EMAIL_DOMAIN="superquina.com"
# APP_BASE_URL="https://your-development-domain.example"

# Encrypts Pix keys saved with withdrawal requests. Generate 32 random bytes and provide as 64 hex chars or base64; keep stable across restarts and never commit the real key.
# WALLET_PIX_ENCRYPTION_KEY="replace-with-32-random-bytes-in-hex-or-base64"

# One-time admin bootstrap inputs only; inject temporarily for the command and remove afterward.
# ADMIN_USERNAME=
# ADMIN_INITIAL_PASSWORD=
# CONFIRM_ADMIN_PROVISIONING=CREATE_FIRST_ADMIN


# Official Super Quina website and prize-redemption support contact.
# Production site: https://superquina.com
# WhatsApp digits only, including country code and area code.
NEXT_PUBLIC_PRIZE_SUPPORT_WHATSAPP="5577991601217"
