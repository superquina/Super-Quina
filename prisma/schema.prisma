generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLAYER
  CASHIER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  BLOCKED
  PENDING
}

enum RoundStatus {
  SCHEDULED
  OPEN
  CLOSED
  COMPLETED
  CANCELLED
}

enum PurchaseStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum ParticipationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  PIX
  WALLET
  CASH
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  EXPIRED
  REFUNDED
  CANCELLED
}

enum LedgerEntryType {
  DEPOSIT
  PURCHASE_DEBIT
  PRIZE_CREDIT
  WITHDRAWAL_RESERVE
  WITHDRAWAL_RELEASE
  WITHDRAWAL_PAID
  REFUND
  ADJUSTMENT
}

enum NumericPrizePayoutChannel {
  PLATFORM_PIX
  CASHIER_CASH
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  REJECTED
}

enum PrintJobPurpose {
  AUTO_RECEIPT
  MANUAL_REPRINT
}

enum PrintJobStatus {
  RESERVED
  SENDING
  SENT
  FAILED
  UNKNOWN
}

model User {
  id                    String        @id @default(cuid())
  username              String        @unique
  fullName              String?
  whatsapp              String?
  commissionRateBasisPoints Int       @default(0)
  passwordHash          String
  role                  UserRole      @default(PLAYER)
  status                AccountStatus @default(ACTIVE)
  mustChangePassword    Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  sessions              Session[]
  purchasesAsPlayer     Purchase[]    @relation("PlayerPurchases")
  purchasesAsCashier    Purchase[]    @relation("CashierPurchases")
  ledgerEntries         LedgerEntry[]
  withdrawals           Withdrawal[]  @relation("WithdrawalOwner")
  reviewedWithdrawals   Withdrawal[]  @relation("WithdrawalReviewer")
  auditEvents           AuditEvent[]  @relation("AuditActor")
  settingsChanged       SettingChange[] @relation("SettingChanger")
  commissions           CashierCommission[]
  customersCreated      Customer[]              @relation("CustomerCreator")
  withdrawalHistoryActions WithdrawalStatusHistory[] @relation("WithdrawalHistoryActor")
  cashierSettlementsAsCashier CashierSettlement[] @relation("CashierSettlementCashier")
  cashierSettlementsCreated CashierSettlement[] @relation("CashierSettlementAdmin")
  numericPrizePayoutsCreated NumericPrizePayout[] @relation("NumericPrizePayoutActor")
  numericPrizePayoutsAsCashier NumericPrizePayout[] @relation("NumericPrizePayoutCashier")
  printJobsRequested PrintJob[] @relation("PrintJobRequester")

  @@index([role, status])
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  purchases   Purchase[]
  createdBy   User?    @relation("CustomerCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([phone])
  @@index([createdAt])
}

model Round {
  id              String                   @id @default(cuid())
  code            String                   @unique
  startsAt        DateTime
  cutoffAt        DateTime
  resultAt        DateTime
  status          RoundStatus               @default(SCHEDULED)
  /// Five-digit result for numeric rounds, stored as text to preserve leading zeroes.
  resultNumber    String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  participations  PurchaseParticipation[]

  @@index([status, startsAt])
  @@index([resultAt])
  @@index([cutoffAt, status])
}

model Purchase {
  id                String        @id @default(cuid())
  playerId          String?
  cashierId         String?
  customerId        String?
  status            PurchaseStatus @default(PENDING_PAYMENT)
  paymentMethod     PaymentMethod
  totalCents        Int
  currency          String        @default("BRL")
  receiptCode       String?       @unique
  idempotencyKey    String        @unique
  createdAt         DateTime      @default(now())
  confirmedAt       DateTime?
  player            User?         @relation("PlayerPurchases", fields: [playerId], references: [id], onDelete: Restrict)
  cashier           User?         @relation("CashierPurchases", fields: [cashierId], references: [id], onDelete: Restrict)
  customer          Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  participations    PurchaseParticipation[]
  numericIntent     NumericPurchaseIntent?
  payment           Payment?
  ledgerEntries     LedgerEntry[]
  commission        CashierCommission?
  printJobs         PrintJob[]

  @@index([playerId, createdAt])
  @@index([cashierId, createdAt])
  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([status, paymentMethod, id])
}

model NumericPurchaseIntent {
  id           String   @id @default(cuid())
  purchaseId   String   @unique
  roundCount   Int
  numbers      Json
  allocation   Json
  ruleVersion  String
  ruleSnapshot Json
  createdAt    DateTime @default(now())
  purchase     Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
}

model PurchaseParticipation {
  id             String              @id @default(cuid())
  purchaseId     String
  roundId        String
  status         ParticipationStatus @default(PENDING)
  totalCents     Int
  createdAt      DateTime            @default(now())
  confirmedAt    DateTime?
  purchase       Purchase            @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  round          Round               @relation(fields: [roundId], references: [id], onDelete: Restrict)
  numericLines   NumericParticipationLine[]
  ledgerEntries  LedgerEntry[]

  @@unique([purchaseId, roundId])
  @@index([roundId, status, createdAt])
  @@index([purchaseId, status])
}

model NumericParticipationLine {
  id               String   @id @default(cuid())
  participationId  String
  numberValue      String
  unitCents        Int
  tensCents        Int
  hundredsCents    Int
  thousandsCents   Int
  quinaCents       Int
  ruleVersion      String
  ruleSnapshot     Json
  prizeCents       Int?
  prizeCreditedAt  DateTime?
  createdAt        DateTime @default(now())
  participation    PurchaseParticipation @relation(fields: [participationId], references: [id], onDelete: Restrict)
  prizePayout      NumericPrizePayout?

  @@index([numberValue])
  @@index([participationId])
}

model Payment {
  id                    String        @id @default(cuid())
  purchaseId            String        @unique
  provider              String
  providerPaymentId     String?
  pixCopyPaste           String?
  pixQrCodeBase64        String?
  pixTicketUrl           String?
  providerStatus         String?
  providerStatusDetail   String?
  idempotencyKey        String        @unique
  status                PaymentStatus @default(PENDING)
  amountCents           Int
  confirmedAt           DateTime?
  expiresAt             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  purchase              Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  webhookEvents         WebhookEvent[]

  @@unique([provider, providerPaymentId])
  @@index([status, createdAt])
  @@index([provider, status, updatedAt, createdAt])
}

model WebhookEvent {
  id                String   @id @default(cuid())
  provider          String
  providerEventId   String
  eventType         String
  payloadDigest     String
  receivedAt        DateTime @default(now())
  processedAt       DateTime?
  processingError   String?
  paymentId         String?
  payment           Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerEventId])
  @@index([processedAt, receivedAt])
}

model LedgerEntry {
  id               String          @id @default(cuid())
  userId           String
  purchaseId       String?
  participationId  String?
  withdrawalId     String?
  type             LedgerEntryType
  amountCents      Int
  currency         String          @default("BRL")
  idempotencyKey   String          @unique
  description      String
  createdAt        DateTime        @default(now())
  user             User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  purchase         Purchase?       @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  participation    PurchaseParticipation? @relation(fields: [participationId], references: [id], onDelete: Restrict)
  withdrawal       Withdrawal?     @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([purchaseId])
  @@index([participationId])
  @@index([withdrawalId])
}

model CashierCommission {
  id                    String   @id @default(cuid())
  purchaseId            String   @unique
  cashierId             String
  rateBasisPoints       Int
  amountCents           Int
  createdAt             DateTime @default(now())
  purchase              Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  cashier               User     @relation(fields: [cashierId], references: [id], onDelete: Restrict)

  @@index([cashierId, createdAt])
}

model CashierSettlement {
  id                    String   @id @default(cuid())
  cashierId             String
  adminId               String
  settledAt             DateTime @default(now())
  cashSalesCents        Int
  pixSalesCents         Int
  totalSalesCents       Int
  salesCount            Int
  gamesCount            Int      @default(0)
  commissionCents       Int
  cashPrizePayoutCount  Int      @default(0)
  cashPrizePayoutCents  Int      @default(0)
  cashier               User     @relation("CashierSettlementCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  admin                 User     @relation("CashierSettlementAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  cashPrizePayouts      NumericPrizePayout[]

  @@index([cashierId, settledAt])
  @@index([adminId, settledAt])
}

model NumericPrizePayout {
  id                   String                    @id @default(cuid())
  participationLineId String                    @unique
  channel              NumericPrizePayoutChannel
  amountCents          Int
  actorId              String
  cashierId            String?
  settlementId         String?
  reference            String?
  paidAt               DateTime                  @default(now())
  participationLine    NumericParticipationLine  @relation(fields: [participationLineId], references: [id], onDelete: Restrict)
  actor                User                      @relation("NumericPrizePayoutActor", fields: [actorId], references: [id], onDelete: Restrict)
  cashier              User?                     @relation("NumericPrizePayoutCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  settlement           CashierSettlement?        @relation(fields: [settlementId], references: [id], onDelete: Restrict)

  @@index([cashierId, paidAt])
  @@index([settlementId])
}

model Withdrawal {
  id                  String                 @id @default(cuid())
  userId              String
  amountCents         Int
  pixKeyEncrypted     String
  status              WithdrawalStatus       @default(PENDING)
  idempotencyKey      String                 @unique
  reviewedById        String?
  providerRef         String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  user                User                   @relation("WithdrawalOwner", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy          User?                  @relation("WithdrawalReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  statusHistory       WithdrawalStatusHistory[]
  ledgerEntries       LedgerEntry[]

  @@index([userId, status, createdAt])
  @@index([reviewedById, updatedAt])
}

model WithdrawalStatusHistory {
  id            String           @id @default(cuid())
  withdrawalId  String
  fromStatus    WithdrawalStatus?
  toStatus      WithdrawalStatus
  actorId       String?
  note          String?
  createdAt     DateTime         @default(now())
  withdrawal    Withdrawal      @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)
  actor         User?            @relation("WithdrawalHistoryActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([withdrawalId, createdAt])
}

model Setting {
  key        String   @id
  value      String
  updatedAt  DateTime @updatedAt
  changes    SettingChange[]
}

model SettingChange {
  id           String   @id @default(cuid())
  settingKey   String
  oldValue     String?
  newValue     String
  changedById  String
  changedAt    DateTime @default(now())
  setting      Setting  @relation(fields: [settingKey], references: [key], onDelete: Restrict)
  changedBy    User     @relation("SettingChanger", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([settingKey, changedAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}


model LoginAttemptBucket {
  keyHash         String   @id
  attempts        Int      @default(0)
  windowStartedAt DateTime @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime @updatedAt

  @@index([blockedUntil])
  @@index([windowStartedAt])
}

model PrintJob {
  id             String          @id @default(cuid())
  purchaseId     String
  purpose        PrintJobPurpose
  /// For AUTO_RECEIPT, equals purchaseId; unique nullable key permits unlimited audited manual reprints.
  autoReceiptKey String?         @unique
  status         PrintJobStatus  @default(RESERVED)
  requestedById  String?
  deviceName     String?
  errorCode      String?
  reservedAt     DateTime        @default(now())
  sendingAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchase       Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  requestedBy    User?           @relation("PrintJobRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([purchaseId, createdAt])
  @@index([status, updatedAt])
  @@index([requestedById, createdAt])
}
